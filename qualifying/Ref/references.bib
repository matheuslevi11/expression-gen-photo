% PRIOR ART for AU-intensity-conditioned text-to-image generation.
% Frozen SD 2.1-base + AU encoder + decoupled cross-attention + LoRA-32.
% Intensity control shown qualitatively only; no identity metric.
@article{varanka2024fineface,
  author  = {Varanka, Tuomas and Khor, Huai-Qian and Li, Yante and Wei, Mengting and Kung, Hanwei and Sebe, Nicu and Zhao, Guoying},
  title   = {Towards Localized Fine-Grained Control for Facial Expression Generation},
  journal = {arXiv preprint arXiv:2407.20175},
  year    = {2024}
}

% Same group as FineFace; the editing sibling. 12-dim AU *variation* vector,
% full UNet fine-tune + UNet-copy ID encoder. AU dropout + expression-CFG.
@article{wei2025magicface,
  author  = {Wei, Mengting and Varanka, Tuomas and Jiang, Xingxun and Khor, Huai-Qian and Zhao, Guoying},
  title   = {MagicFace: High-Fidelity Facial Expression Editing with Action-Unit Control},
  journal = {arXiv preprint arXiv:2501.02260},
  year    = {2025}
}

% Expression *transfer* from an RGB exemplar; IP-Adapter-style injection into
% frozen SD1.5 + ArcFace identity loss on one-step decodes.
@article{jiang2024emojidiff,
  author  = {Jiang, Liangwei and Li, Ruida and Zhang, Zhifeng and Fang, Shuo and Ma, Chenguang},
  title   = {EmojiDiff: Advanced Facial Expression Control with High Identity Preservation in Portrait Generation},
  journal = {arXiv preprint arXiv:2412.01254},
  year    = {2024}
}

% Editing on Qwen-Image-Edit with LoRA-64; intensity scales a text-embedding
% direction. Source of the CLS (control-linearity) evaluation protocol.
@article{hua2026pixelsmile,
  author  = {Hua, Jiabin and Xu, Hengyuan and Li, Aojie and Cheng, Wei and Yu, Gang and Ma, Xingjun and Jiang, Yu-Gang},
  title   = {PixelSmile: Toward Fine-Grained Facial Expression Editing},
  journal = {arXiv preprint arXiv:2603.25728},
  year    = {2026}
}


