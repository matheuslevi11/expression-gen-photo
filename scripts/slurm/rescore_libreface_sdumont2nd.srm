#!/bin/bash
# LibreFace AU intensities for generated clips (scripts/rescore_libreface.py), NPROC CPU
# processes per manifest on one SDumont2nd node; each manifest's shards are concatenated into
# <manifest dir>/results_libreface.jsonl.
#
# Usage (from the repo root):
#   MANIFESTS="inference_output/.../scaled/manifest.jsonl inference_output/.../raise_scaled/manifest.jsonl" \
#   WEIGHTS=/petrobr/crono/.../weights_libreface sbatch scripts/slurm/rescore_libreface_sdumont2nd.srm
#
# CPU only. When cpu_amd is congested, the CPUs of an H100 node work too, e.g.
#   sbatch --partition=petrobr-h100 --gpus-per-node=1 --cpus-per-task=96 ... (the QoS requires one
#   GPU, which stays unused; the arch module follows the partition).
# Resumable: rerun the same command and each shard skips clips already in its shard file.

#SBATCH --job-name=rescore-lf
#SBATCH --account=crono
#SBATCH --partition=cpu_amd
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=192
#SBATCH --time=02:00:00
#SBATCH --output=slurm_logs/%x-%j.out
#SBATCH --error=slurm_logs/%x-%j.err

set -euo pipefail
case "${SLURM_JOB_PARTITION:-cpu_amd}" in
    *h100*) module load arch_gpu ;;
    *)      module load arch_cpu_amd ;;
esac
module load anaconda3/2024.10
set +u
source "$(dirname "$(dirname "$(command -v conda)")")/etc/profile.d/conda.sh"  # not `conda info --base`: it can hang on compute nodes
while [ "${CONDA_SHLVL:-0}" -gt 0 ]; do conda deactivate; done
conda activate libreface
set -u
cd "${SLURM_SUBMIT_DIR}"
export PYTHONUNBUFFERED=1

: "${MANIFESTS:?set MANIFESTS (space-separated manifest.jsonl paths or globs)}"
: "${WEIGHTS:?set WEIGHTS to the cached LibreFace weights dir}"
NPROC=${NPROC:-96}
export OMP_NUM_THREADS=$(( SLURM_CPUS_PER_TASK / NPROC )); [ "${OMP_NUM_THREADS}" -ge 1 ] || OMP_NUM_THREADS=1
export MKL_NUM_THREADS=${OMP_NUM_THREADS}
read -r -a FILES <<< "$(eval echo ${MANIFESTS})"
echo "host $(hostname); ${#FILES[@]} manifests; ${NPROC} procs x ${OMP_NUM_THREADS} threads"

status=0
for m in "${FILES[@]}"; do
    d=$(dirname "${m}")
    pids=()
    for (( k = 0; k < NPROC; k++ )); do
        python scripts/rescore_libreface.py --manifest "${m}" --experiment all --weights-dir "${WEIGHTS}" \
            --shard "${k}" --nshards "${NPROC}" > "${d}/libreface_shard${k}.log" 2>&1 &
        pids+=($!)
    done
    for k in "${!pids[@]}"; do wait "${pids[$k]}" || { echo "FAILED ${m} shard ${k}"; status=1; }; done
    cat "${d}"/results_libreface_shard*.jsonl > "${d}/results_libreface.jsonl"
    echo "$(wc -l < "${d}/results_libreface.jsonl") clips -> ${d}/results_libreface.jsonl"
done
exit ${status}
